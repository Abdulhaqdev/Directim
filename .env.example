# --- Claude (AI) ---
ANTHROPIC_API_KEY=            # console.anthropic.com → API Keys
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low             # low | medium | high — chat uchun low yetarli

# --- Instagram (Meta developer ilovasi — barcha profillar uchun bitta) ---
# Meta ilova → Instagram → API setup with Instagram login → «Instagram app ID» va «Instagram app secret»
IG_APP_ID=
IG_APP_SECRET=                # vergul bilan Meta App secret'ni ham qo'shsa bo'ladi: instagram_secret,meta_secret
IG_VERIFY_TOKEN=              # o'zingiz o'ylab topgan istalgan maxfiy so'z (webhook uchun)
IG_API_VERSION=v26.0
# Profillar tokenlari panelda (Profillar bo'limi) kiritiladi. Quyidagilar faqat birinchi profil uchun (ixtiyoriy):
IG_ACCESS_TOKEN=
IG_USERNAME=ilmbooks.uz

# --- Telegram ---
TELEGRAM_BOT_TOKEN=           # @BotFather'dan
TELEGRAM_CHAT_ID=-1001234567890   # umumiy guruh (Morechat'dagi guruhingiz ID'si); profilga alohida guruh panelda beriladi
TELEGRAM_WEBHOOK_SECRET=      # istalgan maxfiy so'z — Telegram'da Reply qilib javob berish uchun kerak
TELEGRAM_ADMIN_IDS=           # javob bera oladigan Telegram user ID'lar (vergul bilan); bo'sh = guruhdagi hamma
PUBLIC_URL=                   # serveringiz manzili, masalan https://agent.example.com

# --- Katalog (ixtiyoriy) ---
CATALOG_CSV_URL=              # Google Sheets havolasi (panelda ham kiritsa bo'ladi)
CATALOG_SYNC_MINUTES=30
SITE_SYNC_HOURS=24            # saytlardan (shoxmarket.uz va h.k.) narxlarni yangilash oralig'i

# --- Panel ---
ADMIN_PASSWORD=               # panelga kirish paroli (login istalgan)

# Ochiq maxfiylik siyosati sahifasi (/privacy) — Meta ilovani Live qilish uchun talab qiladi
CONTACT_EMAIL=                # mijozlar ma'lumot o'chirishni so'raydigan e-pochta
BUSINESS_NAME=Sotuv agenti    # sahifada ko'rinadigan biznes nomi
